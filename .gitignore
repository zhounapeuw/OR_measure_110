# --- Raw data (large; kept locally, never committed) ---
data/

# --- Built database (regenerate with: python build_db.py) ---
db/

# --- Tableau CSV exports (derived from the marts; regenerate by rebuilding) ---
exports/

# --- Staging CSVs produced by the Python loaders (regenerate by re-running them) ---
staging/

# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# --- Local PostgreSQL cluster (machine-specific data dir, not version-controlled) ---
pgdata/

# --- Machine-specific convenience launchers (hardcode local paths) ---
run.bat
start_postgres.bat
